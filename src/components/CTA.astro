---
import styles from '../styles/components/CTA.module.css';
---

<section id="participe" class="section" aria-labelledby="cta-title">
  <div class={`container ${styles.cta}`}>
    <h2 id="cta-title" class={styles.title}>Faça parte você também</h2>
    <p class={styles.desc}>
      A comunidade é viva e feita por pessoas. Venha fazer parte da
      Tech In Rio!
    </p>
    <div class={styles.actions}>
      <a href="https://github.com/techinrio/docs/blob/master/CONTRIBUICOES.md" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
        Como contribuir
      </a>
      <a href="https://discord.gg/9dWcBM647" target="_blank" rel="noopener noreferrer" class="btn btn--outline">
        Entrar na comunidade
      </a>
    </div>
  </div>
</section>
