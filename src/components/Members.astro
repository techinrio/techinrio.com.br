---
import styles from '../styles/components/Members.module.css';
import Avatar from './Avatar.astro';
import { criarPerfilUrl, getMembers } from '../lib/comunidade';

const members = await getMembers();
---

<section class={`${styles.members} section`} aria-labelledby="members-title">
  <div class="container">
    <span class="section-label" aria-hidden="true">// comunidade</span>
    <h1 id="members-title" class="section-title">Quem faz a Tech In Rio</h1>
    <p class="section-desc">
      Pessoas que constroem a comunidade junto. Quer aparecer aqui? Crie o seu perfil com uma Pull Request no GitHub.
    </p>

    {
      members.length === 0 ? (
        <p class={styles.empty}>Ainda não tem ninguém por aqui. Chega junto e seja a primeira pessoa!</p>
      ) : (
        <ul class={styles.grid} role="list">
          {members.map((m) => (
            <li>
              <a href={`/comunidade/${m.slug}/`} class={styles.card}>
                <Avatar nome={m.nome} foto={m.foto} decorativa />
                <div class={styles.info}>
                  <h2>{m.nome}</h2>
                  <p class={styles.role}>{m.cargo}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class={styles.contribute}>
      <a
        href={criarPerfilUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary"
      >
        Criar meu perfil
        <span class="sr-only">abre em nova aba</span>
      </a>
      <a
        href="https://github.com/techinrio/techinrio.com.br/blob/master/CONTRIBUINDO.md"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--outline"
      >
        Como contribuir
        <span class="sr-only">abre em nova aba</span>
      </a>
    </p>
  </div>
</section>
