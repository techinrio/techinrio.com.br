---
import styles from '../../styles/components/Deck.module.css';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<main id="main" class={styles.deck} data-deck>
  <div
    class={styles.stage}
    role="region"
    aria-roledescription="apresentação"
    aria-label={label}
    aria-describedby="deck-help"
    tabindex="-1"
    data-deck-stage
  >
    <slot />

    <div class={styles.chrome} data-deck-chrome hidden>
      <span class={styles.brand} aria-hidden="true">
        <img src="/img/symbol-orange.png" alt="" width="1000" height="1000" />
        Tech<span>In</span>Rio
      </span>
      <div class={styles.controls}>
        <button type="button" class={styles.control} aria-label="Slide anterior" data-deck-prev>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 7.4 14 6l-6 6 6 6 1.4-1.4-4.6-4.6z" /></svg>
        </button>
        <span class={styles.counter} aria-hidden="true" data-deck-counter></span>
        <button type="button" class={styles.control} aria-label="Próximo slide" data-deck-next>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 16.6 10 18l6-6-6-6-1.4 1.4 4.6 4.6z" /></svg>
        </button>
        <button
          type="button"
          class={styles.control}
          aria-label="Tela cheia"
          aria-pressed="false"
          data-deck-fullscreen
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 14H5v5h5v-2H7zm-2-4h2V7h3V5H5zm12 7h-3v2h5v-5h-2zM14 5v2h3v3h2V5z" /></svg>
        </button>
      </div>
      <div class={styles.progress} aria-hidden="true"><span data-deck-progress></span></div>
    </div>

    <div class={styles.blackout} aria-hidden="true" data-deck-blackout hidden></div>
  </div>

  <p id="deck-help" class="sr-only">
    Use as setas, Page Up e Page Down ou o passador de slides para navegar. F liga a tela cheia e B
    escurece a tela.
  </p>
  <p class="sr-only" aria-live="polite" data-deck-status></p>
</main>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const stage = deck?.querySelector<HTMLElement>('[data-deck-stage]');
  const slides = deck ? [...deck.querySelectorAll<HTMLElement>('[data-slide]')] : [];

  if (deck && stage && slides.length > 0) {
    const chrome = deck.querySelector<HTMLElement>('[data-deck-chrome]')!;
    const counter = deck.querySelector<HTMLElement>('[data-deck-counter]')!;
    const progress = deck.querySelector<HTMLElement>('[data-deck-progress]')!;
    const status = deck.querySelector<HTMLElement>('[data-deck-status]')!;
    const blackout = deck.querySelector<HTMLElement>('[data-deck-blackout]')!;
    const prevButton = deck.querySelector<HTMLButtonElement>('[data-deck-prev]')!;
    const nextButton = deck.querySelector<HTMLButtonElement>('[data-deck-next]')!;
    const fullscreenButton = deck.querySelector<HTMLButtonElement>('[data-deck-fullscreen]')!;

    const total = slides.length;
    const pad = (n: number) => String(n).padStart(2, '0');
    let current = -1;

    slides.forEach((slide, i) => {
      slide.setAttribute('aria-label', `${i + 1} de ${total}: ${slide.dataset.title ?? ''}`);
    });

    const indexFromHash = () => {
      const n = Number.parseInt(location.hash.slice(1), 10);
      return Number.isInteger(n) && n >= 1 && n <= total ? n - 1 : 0;
    };

    const setBlackout = (on: boolean) => {
      blackout.hidden = !on;
    };

    const show = (index: number, announce = true) => {
      const target = Math.min(Math.max(index, 0), total - 1);
      setBlackout(false);
      if (target === current) return;

      const hadFocus = current >= 0 && slides[current].contains(document.activeElement);
      slides.forEach((slide, i) => {
        const active = i === target;
        slide.toggleAttribute('data-active', active);
        slide.inert = !active;
      });
      current = target;

      counter.textContent = `${pad(target + 1)} / ${pad(total)}`;
      progress.style.transform = `scaleX(${(target + 1) / total})`;
      prevButton.disabled = target === 0;
      nextButton.disabled = target === total - 1;
      history.replaceState(null, '', `#${target + 1}`);
      if (announce) status.textContent = slides[target].getAttribute('aria-label') ?? '';
      if (hadFocus) stage.focus({ preventScroll: true });
    };

    const toggleFullscreen = () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else deck.requestFullscreen();
    };

    const forwardKeys = new Set(['ArrowRight', 'ArrowDown', 'PageDown']);
    const backKeys = new Set(['ArrowLeft', 'ArrowUp', 'PageUp']);

    document.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      const onControl =
        event.target instanceof Element && event.target.closest('a, button, input, select, textarea');

      if (event.key === ' ') {
        if (onControl) return;
        event.preventDefault();
        show(current + (event.shiftKey ? -1 : 1));
      } else if (forwardKeys.has(event.key)) {
        event.preventDefault();
        show(current + 1);
      } else if (backKeys.has(event.key)) {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        show(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        show(total - 1);
      } else if (event.key === 'f' || event.key === 'F') {
        if (document.fullscreenEnabled) toggleFullscreen();
      } else if (event.key === 'b' || event.key === 'B' || event.key === '.') {
        setBlackout(blackout.hidden);
      } else if (event.key === 'Escape') {
        setBlackout(false);
      }
    });

    prevButton.addEventListener('click', () => show(current - 1));
    nextButton.addEventListener('click', () => show(current + 1));

    if (document.fullscreenEnabled) {
      fullscreenButton.addEventListener('click', toggleFullscreen);
      document.addEventListener('fullscreenchange', () => {
        const on = Boolean(document.fullscreenElement);
        fullscreenButton.setAttribute('aria-pressed', String(on));
        fullscreenButton.setAttribute('aria-label', on ? 'Sair da tela cheia' : 'Tela cheia');
      });
    } else {
      fullscreenButton.hidden = true;
    }

    let startX: number | null = null;
    let startY = 0;
    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      startX = event.clientX;
      startY = event.clientY;
    });
    stage.addEventListener('pointercancel', () => {
      startX = null;
    });
    stage.addEventListener('pointerup', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      startX = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    });

    window.addEventListener('hashchange', () => show(indexFromHash()));

    deck.toggleAttribute('data-ready', true);
    chrome.hidden = false;
    show(indexFromHash(), false);
  }
</script>
