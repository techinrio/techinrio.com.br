---
import styles from '../styles/components/Connect.module.css';
---

<section id="conecte-se" class={`${styles.connect} section`} aria-labelledby="connect-title">
  <div class="container">
    <span class="section-label" aria-hidden="true">// conecte-se</span>
    <h2 id="connect-title" class="section-title">Faz parte com a gente</h2>
    <p class="section-desc">
      A comunidade é viva e feita por pessoas. Acompanha a Tech In Rio
      nos canais e chega junto!
    </p>

    <div class={styles.grid}>
      <a href="https://www.instagram.com/techinrio/" target="_blank" rel="noopener noreferrer" class={styles.card}>
        <span class={styles.cardIcon} aria-hidden="true">&#9879;</span>
        <div class={styles.cardInfo}>
          <h3>Instagram</h3>
          <p>Novidades, eventos e bastidores</p>
        </div>
      </a>

      <a href="https://www.youtube.com/@techinrio" target="_blank" rel="noopener noreferrer" class={styles.card}>
        <span class={styles.cardIcon} aria-hidden="true">&#9654;</span>
        <div class={styles.cardInfo}>
          <h3>YouTube</h3>
          <p>Palestras e conteúdos gravados</p>
        </div>
      </a>

      <a href="https://github.com/techinrio" target="_blank" rel="noopener noreferrer" class={styles.card}>
        <span class={styles.cardIcon} aria-hidden="true">&#128187;</span>
        <div class={styles.cardInfo}>
          <h3>GitHub</h3>
          <p>Código aberto e colaboração</p>
        </div>
      </a>

      <a href="https://twitter.com/techinrio" target="_blank" rel="noopener noreferrer" class={styles.card}>
        <span class={styles.cardIcon} aria-hidden="true">&#10003;</span>
        <div class={styles.cardInfo}>
          <h3>Twitter / X</h3>
          <p>Discussões e atualizações rápidas</p>
        </div>
      </a>

      <a href="https://www.linkedin.com/company/tech-in-rio/" target="_blank" rel="noopener noreferrer" class={styles.card}>
        <span class={styles.cardIcon} aria-hidden="true">&#128279;</span>
        <div class={styles.cardInfo}>
          <h3>LinkedIn</h3>
          <p>Carreira e oportunidades</p>
        </div>
      </a>

      <a href="https://discord.gg/9dWcBM647" target="_blank" rel="noopener noreferrer" class={styles.card}>
        <span class={styles.cardIcon} aria-hidden="true">&#128172;</span>
        <div class={styles.cardInfo}>
          <h3>Discord</h3>
          <p>Conversas e comunidade ao vivo</p>
        </div>
      </a>
    </div>
  </div>
</section>
