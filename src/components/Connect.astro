---
import styles from '../styles/components/Connect.module.css';
import SocialIcon from './SocialIcon.astro';
import { community, channels } from '../data/socials.js';
---

<section id="conecte-se" class={`${styles.connect} section`} aria-labelledby="connect-title">
  <div class="container">
    <span class="section-label" aria-hidden="true">// conecte-se</span>
    <h2 id="connect-title" class="section-title">Faz parte com a gente</h2>
    <p class="section-desc">
      A porta de entrada é o grupo do WhatsApp. Nos outros canais você
      acompanha novidades, conteúdo e código.
    </p>

    <div class={styles.grid}>
      <a
        href={community.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`${styles.card} ${styles.featured}`}
      >
        <span class={styles.cardIcon}>
          <SocialIcon name={community.id} />
        </span>
        <div class={styles.cardInfo}>
          <h3>{community.name}</h3>
          <p>{community.description}</p>
        </div>
        <span class="sr-only">abre em nova aba</span>
      </a>

      {channels.map((channel) => (
        <a
          href={channel.href}
          target="_blank"
          rel="noopener noreferrer"
          class={styles.card}
        >
          <span class={styles.cardIcon}>
            <SocialIcon name={channel.id} />
          </span>
          <div class={styles.cardInfo}>
            <h3>{channel.name}</h3>
            <p>{channel.description}</p>
          </div>
          <span class="sr-only">abre em nova aba</span>
        </a>
      ))}
    </div>
  </div>
</section>
