---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página não encontrada — Tech In Rio" description="Essa página não existe.">
  <Nav />
  <main id="main" class="section" style="padding-top:calc(var(--nav-height) + 4rem);min-height:70vh;">
    <div class="container">
      <span class="section-label" aria-hidden="true">// 404</span>
      <h1 class="section-title">Deu ruim, parceiro</h1>
      <p class="section-desc">Essa página não existe ou mudou de lugar.</p>
      <p style="margin-top:2rem;">
        <a href="/" class="btn btn--primary">Voltar pra home</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>
