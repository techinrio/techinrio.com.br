---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import MemberProfile from '../../components/MemberProfile.astro';
import Footer from '../../components/Footer.astro';
import { getMembers } from '../../lib/comunidade';

export async function getStaticPaths() {
  const members = await getMembers();
  return members.map((member) => ({ params: { slug: member.slug }, props: { member } }));
}

const { member } = Astro.props;
---

<Layout
  title={`${member.nome} — ${member.cargo} | Tech In Rio`}
  description={`${member.nome}, ${member.cargo}, faz parte da comunidade Tech In Rio.`}
>
  <Nav />
  <main id="main">
    <MemberProfile member={member} />
  </main>
  <Footer />
</Layout>
