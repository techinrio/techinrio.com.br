---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import MemberProfile from '../../components/MemberProfile.astro';
import Footer from '../../components/Footer.astro';
import { getMembers } from '../../lib/comunidade';
import { cardPath } from '../../lib/og-membro';

export async function getStaticPaths() {
  const members = await getMembers();
  return members.map((member) => ({ params: { slug: member.slug }, props: { member } }));
}

const { member } = Astro.props;
---

<Layout
  title={`${member.nome} — ${member.cargo} | Tech In Rio`}
  description={`${member.nome}, ${member.cargo}. Membro oficial da Tech In Rio.`}
  ogType="profile"
  image={{
    path: cardPath(member),
    alt: `Cartão de ${member.nome}, ${member.cargo}, membro oficial da Tech In Rio`,
    width: 1200,
    height: 630,
    type: 'image/png',
  }}
>
  <Nav />
  <main id="main">
    <MemberProfile member={member} />
  </main>
  <Footer />
</Layout>
